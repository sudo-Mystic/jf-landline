<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/background" android:scrollbars="none" android:overScrollMode="ifContentScrolls">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="20dp" android:paddingRight="20dp" android:paddingTop="20dp" android:paddingBottom="26dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="25dp">
            <TextView android:layout_width="48dp" android:layout_height="48dp" android:text="JF" android:id="@+id/iv_app_icon" android:background="@drawable/bg_icon_badge" android:textColor="@color/on_dark_primary" android:textStyle="bold" android:textSize="20sp" android:gravity="center" android:contentDescription="Jio Landline" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginLeft="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="landline." android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="26sp" android:letterSpacing="-0.02" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HOME LINE  /  CONTROL" android:textColor="@color/text_muted" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.07" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="36dp" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/ll_status_pill" android:background="@drawable/bg_status_pill_amber" android:paddingLeft="12dp" android:paddingRight="12dp">
                <ImageView android:id="@+id/iv_status_dot" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/ic_dot_amber" android:contentDescription="Connection status" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CONNECTING" android:id="@+id/tv_status_pill" android:textColor="@color/status_amber" android:textSize="10sp" android:textStyle="bold" android:layout_marginLeft="6dp" android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_line_hero" android:padding="23dp" android:layout_marginBottom="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingRight="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="YOUR JIO LINE" android:textColor="@color/on_dark_secondary" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.13" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Checking line…" android:id="@+id/tv_phone_number" android:textColor="@color/on_dark_primary" android:textSize="29sp" android:textStyle="bold" android:layout_marginTop="6dp" android:singleLine="true" android:ellipsize="end" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textColor="@color/call_accent" android:textSize="19sp" android:contentDescription="Connection indicator" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Checking connection…" android:id="@+id/tv_status_desc" android:accessibilityLiveRegion="polite" android:textColor="@color/on_dark_secondary" android:textSize="13sp" android:layout_marginTop="12dp" android:maxLines="2" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#527572" android:layout_marginTop="22dp" android:layout_marginBottom="18dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingRight="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NETWORK ROUTER" android:textSize="10sp" android:textColor="@color/on_dark_muted" android:textStyle="bold" android:letterSpacing="0.1" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Router: Detecting" android:id="@+id/tv_router_host" android:textSize="12sp" android:textColor="@color/on_dark_primary" android:singleLine="true" android:ellipsize="end" android:layout_marginTop="5dp" />
                </LinearLayout>
                <Button android:id="@+id/btn_refresh" android:layout_width="118dp" android:layout_height="48dp" android:text="Re-provision" android:textAllCaps="false" android:minHeight="48dp" android:background="@drawable/bg_hero_button" android:textColor="@color/on_dark_primary" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_inner" android:padding="16dp" android:layout_marginBottom="23dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingRight="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CONNECTION DETAILS" style="@style/DashboardOverline" android:textSize="10sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Keep this phone on the Jio router network." android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="5dp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TLS" android:textColor="@color/call_green" android:textStyle="bold" android:textSize="12sp" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginBottom="12dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingRight="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Port: 5068 (TLS)" android:id="@+id/tv_sip_port" android:textColor="@color/text_primary" android:textSize="12sp" android:singleLine="true" android:ellipsize="end" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Realm: Jio IMS" android:id="@+id/tv_realm_info" android:textColor="@color/text_secondary" android:textSize="11sp" android:layout_marginTop="7dp" android:singleLine="true" android:ellipsize="end" />
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wi-Fi: Checking" android:id="@+id/tv_wifi_ssid" android:textColor="@color/text_primary" android:textSize="12sp" android:singleLine="true" android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="14dp" android:layout_marginTop="13dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="01 / CALLS" style="@style/DashboardOverline" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Call handling" style="@style/DashboardSectionTitle" android:layout_marginTop="4dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Choose how the line works with your Android phone." android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="5dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp" android:layout_marginBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="76dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingRight="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Intercept dialer calls" style="@style/DashboardRowTitle" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Route supported outgoing calls through this landline." style="@style/DashboardRowSubtitle" android:layout_marginTop="4dp" android:maxLines="3" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_intercept" android:contentDescription="Intercept stock dialer calls" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="48dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_inner" android:padding="13dp" android:layout_marginTop="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Checking interception settings…" android:id="@+id/tv_intercept_status" android:textColor="@color/text_secondary" android:textSize="12sp" android:maxLines="3" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Emergency numbers bypass interception." android:textColor="@color/text_muted" android:textSize="12sp" android:layout_marginTop="12dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/card_telecom_section" android:background="@drawable/bg_card" android:padding="18dp" android:layout_marginBottom="22dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="ANDROID PHONE ACCOUNT" style="@style/DashboardOverline" android:layout_weight="1" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SYSTEM" android:textColor="@color/call_green" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/ll_telecom_controls">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="76dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingRight="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="System calling account" style="@style/DashboardRowTitle" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Allow Android to recognize this Jio line." style="@style/DashboardRowSubtitle" android:layout_marginTop="4dp" android:maxLines="3" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_telecom" android:contentDescription="Use Android system calling account" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="48dp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginBottom="8dp" android:layout_marginTop="4dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="76dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingRight="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Use Android call screen" style="@style/DashboardRowTitle" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Show the phone's native in-call interface." style="@style/DashboardRowSubtitle" android:layout_marginTop="4dp" android:maxLines="3" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_telecom_ui" android:contentDescription="Use Android in-call screen" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="48dp" />
                </LinearLayout>
                <Button android:id="@+id/btn_open_telecom_settings" android:layout_width="match_parent" android:layout_height="48dp" android:text="Open Android calling settings" android:textAllCaps="false" android:minHeight="48dp" android:layout_marginTop="10dp" android:background="@drawable/bg_btn_secondary" android:textColor="@color/text_primary" android:textSize="13sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Checking Android Telecom…" android:id="@+id/tv_telecom_status" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="12dp" android:maxLines="2" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="14dp" android:layout_marginTop="13dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="02 / ACCESS" style="@style/DashboardOverline" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Companion gateway" style="@style/DashboardSectionTitle" android:layout_marginTop="4dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Connect a second device to this phone's landline." android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="5dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp" android:layout_marginBottom="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COMPANION ACCESS" style="@style/DashboardOverline" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Other devices, same landline." android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" android:layout_marginTop="8dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Manage your local gateway and the PIN used by companion devices." android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="8dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_pin_container" android:padding="15dp" android:layout_marginTop="16dp" android:layout_marginBottom="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Companion Gateway: Checking" android:id="@+id/tv_gateway_info" android:textColor="@color/text_primary" android:textSize="13sp" android:singleLine="true" android:ellipsize="end" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginBottom="14dp" android:layout_marginTop="14dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PIN: —" android:id="@+id/tv_gateway_pin" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" android:maxLines="2" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <Button android:id="@+id/btn_copy_pin" android:layout_width="0dp" android:layout_height="48dp" android:text="Copy PIN" android:textAllCaps="false" android:minHeight="48dp" android:layout_weight="1" android:background="@drawable/bg_btn_primary" android:textColor="@color/on_dark_primary" android:textSize="13sp" android:layout_marginRight="6dp" />
                <Button android:id="@+id/btn_new_pin" android:layout_width="0dp" android:layout_height="48dp" android:text="Generate new" android:textAllCaps="false" android:minHeight="48dp" android:layout_weight="1" android:background="@drawable/bg_btn_secondary" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_marginLeft="6dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="14dp" android:layout_marginTop="13dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="03 / DEVICE" style="@style/DashboardOverline" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="System health" style="@style/DashboardSectionTitle" android:layout_marginTop="4dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Connection and codec information at a glance." android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="5dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp" android:layout_marginBottom="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DEVICE DIAGNOSTICS" style="@style/DashboardOverline" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Technical details" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" android:layout_marginTop="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Useful when troubleshooting the router or VoIP engine." android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="7dp" android:layout_marginBottom="9dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_inner" android:padding="13dp" android:layout_marginTop="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="11dp" android:paddingBottom="11dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Local IP: Checking…" android:id="@+id/tv_diag_ip" android:textColor="@color/text_secondary" android:textSize="13sp" android:singleLine="true" android:ellipsize="end" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="11dp" android:paddingBottom="11dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Codec: AMR-NB preferred" android:id="@+id/tv_diag_codec" android:textColor="@color/text_secondary" android:textSize="13sp" android:singleLine="true" android:ellipsize="end" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="11dp" android:paddingBottom="11dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MAC: Unknown" android:id="@+id/tv_diag_mac" android:textColor="@color/text_secondary" android:textSize="13sp" android:singleLine="true" android:ellipsize="end" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="11dp" android:paddingBottom="11dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Engine: PJSIP" android:id="@+id/tv_diag_engine" android:textColor="@color/text_secondary" android:textSize="13sp" android:singleLine="true" android:ellipsize="end" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="11dp" android:paddingBottom="11dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OS: Android" android:id="@+id/tv_diag_android" android:textColor="@color/text_secondary" android:textSize="13sp" android:singleLine="true" android:ellipsize="end" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="11dp" android:paddingBottom="11dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Keepalive: 45s" android:id="@+id/tv_diag_keepalive" android:textColor="@color/text_secondary" android:textSize="13sp" android:singleLine="true" android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="JIO LANDLINE   /   BUILT FOR YOUR HOME" android:textColor="@color/text_muted" android:textSize="10sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="14dp" android:layout_marginBottom="16dp" />
    </LinearLayout>
</ScrollView>
