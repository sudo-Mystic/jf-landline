<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/call_background" android:paddingLeft="20dp" android:paddingRight="20dp" android:paddingTop="16dp" android:paddingBottom="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/call_top" android:layout_alignParentTop="true" android:paddingTop="10dp" android:paddingBottom="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textColor="@color/call_accent" android:textSize="16sp" android:layout_marginRight="7dp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="JIO LANDLINE" android:textColor="@color/on_dark_secondary" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12" android:layout_weight="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VOICE" android:textColor="@color/on_dark_muted" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.1" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7044756295" android:id="@+id/tv_call_number" android:textColor="@color/on_dark_primary" android:textSize="31sp" android:textStyle="bold" android:layout_marginTop="25dp" android:singleLine="true" android:ellipsize="end" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Calling…" android:id="@+id/tv_call_status" android:textColor="@color/on_dark_secondary" android:textSize="14sp" android:layout_weight="1" maxL="2" />
            <Chronometer android:id="@+id/call_chronometer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/call_accent" android:textSize="18sp" android:textStyle="bold" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/call_footer" android:layout_alignParentBottom="true" android:paddingBottom="10dp">
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#345456" android:layout_marginBottom="16dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="19dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:gravity="center">
                <ImageButton android:id="@+id/btn_mute" android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/ic_in_call_mute" android:background="@drawable/bg_action_circle" android:padding="16dp" android:scaleType="fitCenter" android:contentDescription="Mute" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mute" android:textColor="@color/on_dark_secondary" android:textSize="12sp" android:layout_marginTop="9dp" android:id="@+id/tv_mute_label" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:gravity="center">
                <ImageButton android:id="@+id/btn_speaker" android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/ic_in_call_speaker" android:background="@drawable/bg_action_circle" android:padding="16dp" android:scaleType="fitCenter" android:contentDescription="Speaker" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Speaker" android:textColor="@color/on_dark_secondary" android:textSize="12sp" android:layout_marginTop="9dp" android:id="@+id/tv_speaker_label" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:gravity="center">
                <ImageButton android:id="@+id/btn_keypad" android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/ic_in_call_dialpad" android:background="@drawable/bg_action_circle" android:padding="16dp" android:scaleType="fitCenter" android:contentDescription="Dialpad" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dialpad" android:textColor="@color/on_dark_secondary" android:textSize="12sp" android:layout_marginTop="9dp" android:id="@+id/tv_keypad_label" />
            </LinearLayout>
        </LinearLayout>
        <ImageButton android:id="@+id/btn_end_call" android:layout_width="76dp" android:layout_height="76dp" android:layout_gravity="center_horizontal" android:background="@drawable/bg_end_call_circle" android:src="@drawable/ic_in_call_end" android:padding="19dp" android:scaleType="fitCenter" android:contentDescription="End call" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="END CALL" android:textColor="@color/on_dark_secondary" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="10dp" android:gravity="center" android:letterSpacing="0.12" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/call_top" android:layout_above="@id/call_footer" android:paddingTop="12dp" android:paddingBottom="12dp">
        <FrameLayout android:id="@+id/avatar_container" android:layout_width="match_parent" android:layout_height="match_parent">
            <ImageView android:layout_width="134dp" android:layout_height="134dp" android:layout_gravity="center" android:src="@drawable/ic_in_call_avatar" android:background="@drawable/bg_live_roundel" android:padding="37dp" android:scaleType="fitCenter" android:contentDescription="Call illustration" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="VOICE SESSION" android:layout_gravity="bottom|center_horizontal" android:textColor="@color/on_dark_muted" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:letterSpacing="0.1" android:layout_marginBottom="10dp" />
        </FrameLayout>
        <ScrollView android:id="@+id/dtmf_grid" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:scrollbars="none" android:fillViewport="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="3dp">
                    <Button android:id="@+id/btn_dtmf_1" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_margin="3dp" android:text="1" android:textAllCaps="false" android:background="@drawable/bg_dialpad_key" android:textColor="@color/on_dark_primary" android:textSize="24sp" android:minHeight="50dp" />
                    <Button android:id="@+id/btn_dtmf_2" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_margin="3dp" android:text="2" android:textAllCaps="false" android:background="@drawable/bg_dialpad_key" android:textColor="@color/on_dark_primary" android:textSize="24sp" android:minHeight="50dp" />
                    <Button android:id="@+id/btn_dtmf_3" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_margin="3dp" android:text="3" android:textAllCaps="false" android:background="@drawable/bg_dialpad_key" android:textColor="@color/on_dark_primary" android:textSize="24sp" android:minHeight="50dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="3dp">
                    <Button android:id="@+id/btn_dtmf_4" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_margin="3dp" android:text="4" android:textAllCaps="false" android:background="@drawable/bg_dialpad_key" android:textColor="@color/on_dark_primary" android:textSize="24sp" android:minHeight="50dp" />
                    <Button android:id="@+id/btn_dtmf_5" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_margin="3dp" android:text="5" android:textAllCaps="false" android:background="@drawable/bg_dialpad_key" android:textColor="@color/on_dark_primary" android:textSize="24sp" android:minHeight="50dp" />
                    <Button android:id="@+id/btn_dtmf_6" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_margin="3dp" android:text="6" android:textAllCaps="false" android:background="@drawable/bg_dialpad_key" android:textColor="@color/on_dark_primary" android:textSize="24sp" android:minHeight="50dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="3dp">
                    <Button android:id="@+id/btn_dtmf_7" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_margin="3dp" android:text="7" android:textAllCaps="false" android:background="@drawable/bg_dialpad_key" android:textColor="@color/on_dark_primary" android:textSize="24sp" android:minHeight="50dp" />
                    <Button android:id="@+id/btn_dtmf_8" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_margin="3dp" android:text="8" android:textAllCaps="false" android:background="@drawable/bg_dialpad_key" android:textColor="@color/on_dark_primary" android:textSize="24sp" android:minHeight="50dp" />
                    <Button android:id="@+id/btn_dtmf_9" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_margin="3dp" android:text="9" android:textAllCaps="false" android:background="@drawable/bg_dialpad_key" android:textColor="@color/on_dark_primary" android:textSize="24sp" android:minHeight="50dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="3dp">
                    <Button android:id="@+id/btn_dtmf_star" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_margin="3dp" android:text="*" android:textAllCaps="false" android:background="@drawable/bg_dialpad_key" android:textColor="@color/on_dark_primary" android:textSize="24sp" android:minHeight="50dp" />
                    <Button android:id="@+id/btn_dtmf_0" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_margin="3dp" android:text="0" android:textAllCaps="false" android:background="@drawable/bg_dialpad_key" android:textColor="@color/on_dark_primary" android:textSize="24sp" android:minHeight="50dp" />
                    <Button android:id="@+id/btn_dtmf_hash" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_margin="3dp" android:text="#" android:textAllCaps="false" android:background="@drawable/bg_dialpad_key" android:textColor="@color/on_dark_primary" android:textSize="24sp" android:minHeight="50dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</RelativeLayout>
